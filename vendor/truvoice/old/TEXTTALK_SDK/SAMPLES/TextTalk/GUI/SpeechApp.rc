IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 217, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SpeechApp"
FONT 10, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,18,20
    LTEXT           "TextTalk Demo Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Dialogic Corp.  Copyright © 1996",IDC_STATIC,40,25,119,
                    8
    DEFPUSHBUTTON   "OK",IDOK,178,7,32,14,WS_GROUP
END

IDD_SPEECHAPP_FORM DIALOG DISCARDABLE  0, 0, 419, 210
STYLE WS_CHILD
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Channels",IDC_STATIC,9,5,29,8
    CONTROL         "List1",IDC_LIST1,"SysListView32",LVS_REPORT | 
                    LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | 
                    WS_TABSTOP,7,14,404,52
    LTEXT           "Text To Send",IDC_STATIC,7,70,84,8
    EDITTEXT        IDC_EDIT1,7,79,312,105,ES_MULTILINE | ES_AUTOVSCROLL | 
                    ES_AUTOHSCROLL | ES_READONLY | ES_WANTRETURN | 
                    WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON      "&Send Text",IDC_SENDTEXTR,156,188,50,14,WS_DISABLED
    PUSHBUTTON      "&Load Text File",IDC_LOAD,213,188,50,14,WS_DISABLED
    PUSHBUTTON      "&Help",IDC_HELP_ME_RHONDA,269,188,50,14
END

IDD_BLURB DIALOG DISCARDABLE  0, 0, 187, 53
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Speech App Test"
FONT 10, "MS Sans Serif"
BEGIN
    LTEXT           "Initializing Voice Channels.  Please Wait ....",
                    IDC_STATIC,29,19,142,8
END

