0x5904 uint8_t  in_ring[4096]         # cg 0x7068  raw input characters
0x6904 int32_t  in_rd                 # cg 0x8068
0x6908 int32_t  in_wr                 # cg 0x806c
0x690c uint8_t  pre_ring[256]         # cg 0x8070  characters waiting for the preformatter
0x6a0c int32_t  pre_rd                # cg 0x8170
0x6a10 int32_t  pre_wr                # cg 0x8174
0x6a14 uint8_t  mid_ring[4096]        # cg 0x8178  preformatted characters for stage 1
0x7a14 int32_t  mid_rd                # cg 0x9178
0x7a18 int32_t  mid_wr                # cg 0x917c
0x7a1c int32_t  e_9180                # cg 0x9180
0x7a20 uint8_t  mid_wrapped           # tv only  Engine_MidPut 10003940 sets it when the write index wraps and Engine_ResetRings 10003640 clears it
0x7a24 uint8_t  synth_busy            # cg 0x0000
0x7a28 int32_t  trk_04                # cg 0x0004
0x7a2c int32_t  trk_08                # cg 0x0008
0x7a30 int32_t  trk_0c                # cg 0x000c
0x7a34 int32_t  trk_10                # cg 0x0010
0x7a38 uint8_t  trk_14[32]            # cg 0x0014
0x7a58 int32_t  trk_34                # cg 0x0034
0x7a5c int32_t  trk_38                # cg 0x0038
0x7a60 int32_t  trk_wr[22]            # cg 0x003c  per-parameter track write position
0x7ab8 int32_t  trk_rd[22]            # cg 0x0094  per-parameter track read position
0x7b10 uint8_t *trk_buf[22]           # cg 0x00ec  -> trk_data[i]
0x7b68 S3Param  s3_param[22]          # cg 0x0144  per-parameter transition state
0x7dd0 uint8_t  trk_data[22][256]     # cg 0x03ac  22 synthesis-parameter tracks
end
# CGRM_EN fields TV_ENG32 does not have: sapi (cg 0x20f4), fmt_2104 (cg 0x2104), w_2130 (cg 0x2130), w_2132 (cg 0x2132).

# A token of the TextIn front end (malloc'd, 0x3c bytes).  `bits` is a
# 96-bit class set stored most-significant word first: class k lives in
# bits[2 - k/32] (see Bits_Test).
struct Token 0x3c
0x00 Token    *prev
0x04 Token    *next
0x08 int16_t   w08
0x0a int16_t   w0a
0x0c uint32_t  bits[3]
0x18 void     *d18
0x1c uint32_t  d1c
0x20 char     *text
0x24 int16_t   len
0x28 char     *text2  # replacement text emitted instead of `text`
0x2c char     *types  # per-char split marks: 1 plain, 2 split before, 3 split after
0x30 uint8_t   trail  # character that ended the token (emitted after it)
0x34 int16_t   w34
0x36 int16_t   is_number
0x38 int32_t   num  # value of an all-digit token
end

# The TextIn front end (operator new'd, 0x70 bytes): tokenizes the raw input
# ring, classifies and expands tokens, and feeds their text on to the
# preformatter.
struct TextIn 0x70
0x00 Engine   *engine
0x04 int32_t   d04
0x08 int32_t   input_done  # engine input ring ran dry
0x0c int32_t   item_done  # current TextData item fully fed
0x10 int32_t   mode
0x18 int32_t   d18
0x1c Token    *head
0x20 Token    *tail
0x24 Token    *cur  # tokens up to here are expanded
0x28 int32_t   count
0x32 int16_t   in_quote  # mode 4: inside a quoted block
0x34 int16_t   quote_len  # length of the detected quote prefix
0x36 int16_t   quote_count  # consecutive quoted lines seen
0x38 char      quote_prefix[12]
0x44 int32_t   err[10]
0x6c int32_t   nerr
end

# The SAPI "central" object that owns the engine thread.  Only the fields the
# engine itself touches are described; it exists only when the engine runs
# behind the SAPI layer (the portable build leaves Engine.sapi NULL).
struct SapiCentral 0xc10
0x64 int32_t  voice
0x68 uint8_t  mode_info[0xaf0]
0xb60 void    *audio_queue
0xb6c uint8_t  audio_lock[24]  # CRITICAL_SECTION
0xb90 int16_t  pitch
0xb94 int32_t  speed
0xb9c int32_t  volume
0xbac int32_t  ctx
0xbe0 void    *hwnd
end
