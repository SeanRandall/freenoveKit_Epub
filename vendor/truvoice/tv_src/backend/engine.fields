# Engine object layout of TV_ENG32.DLL, generated by tools/backend/gen_layout.py from OpenTV's engine.fields
# (the CGRM_EN.DLL layout). Do not edit: change the generator. SaveFile_Synthesize 10001990 keeps the object
# in its frame at EBP-0x93e4. Only struct Engine differs from OpenTV; the small structs are copied as they are.
# tools/gen_struct.py (OpenTV) turns this into engine_struct.h. Field names are OpenTV's (provisional there).

# One queued input segment of a TextData item, split at line breaks
# (CGRM_EN sub_10055aa0).
struct InputSeg 0x10
0x00 char     *text
0x08 int16_t   len
0x0a uint8_t   caps_only  # no lower-case or high-bit characters
0x0b uint8_t   no_words  # nothing speakable (only punctuation/space)
0x0c uint8_t   flag_c
end

# One entry of the stage 0 rule call stack.
struct S0Frame 0x8
0x00 const uint8_t *ip
0x04 uint8_t   nactions
0x05 uint8_t   skip
end

# A node of the engine's work list.  Every pipeline stage transforms and
# re-labels nodes in place; the low three flag bits are the node type
# (0 = control command, 1..5 = stage-specific kinds, 6 = free, 7 = sentinel).
struct Node 0x20
0x00 Node     *next
0x04 Node     *prev
0x08 uint32_t  flags  # bits 0-2 type, bits 3-7 per-stage flags
0x0c uint32_t  arg  # control nodes: command argument
0x10 uint32_t  d10
0x14 uint8_t   b14
0x15 uint8_t   b15
0x16 uint8_t   value  # character / command letter
0x17 uint8_t   syllable  # 1-based syllable number within the word
0x18 uint8_t   b18
0x19 uint8_t   b19
0x1a uint8_t   b1a  # the output mode in force when stage 2 passed
0x1c uint32_t  notify  # 'i' (index mark) commands: TextData notify context
end

# Per-stage cursor into the work list plus the voice parameters in effect at
# that stage's position (control nodes update them as the stage passes).
# Five of these follow at Engine+0x2144, one per pipeline stage.
struct StageCtx 0x44
0x00 Node     *first  # start of this stage's window
0x04 Node     *cur  # nodes before cur are done by this stage
0x08 Node     *ctl  # next control node to execute
0x0c Node     *scan
0x10 Node     *last  # end of this stage's window
0x14 Node     *d14  # start of the text the stage is matching
0x18 Node     *d18  # scratch cursor
0x1c int32_t   p_1c
0x20 int32_t   p_20
0x24 int32_t   rate_index  # (wpm - 46) >> 3
0x28 int32_t   pitch
0x2c int32_t   volume_atten  # 0..15
0x30 int32_t   p_30
0x34 int32_t   p_34
0x38 int32_t   p_38
0x3c uint32_t  type_mask  # node types this stage processes (bit per type)
0x40 int32_t   voice
end

# The per-parameter transition state stage 3 keeps while it writes a phoneme.
struct S3Param 0x1c
0x00 int32_t  mode  # how the parameter travels (see Stage3_Write)
0x04 int32_t  shape_in  # the curve it blends back along
0x08 int32_t  shape_out  # the curve it decays along, or a ramp length
0x0c int32_t  len  # frames this parameter advances this step
0x10 int32_t  lead  # the value blended into the frames before
0x14 int32_t  start  # where the phoneme's own run starts
0x18 int32_t  target  # and where it settles
end

# TV_ENG32 layout: generated by tools/backend/gen_layout.py from OpenTV's CGRM_EN layout. "cg" is the
